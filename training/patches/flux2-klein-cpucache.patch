+class _AzCpuLatent:
+    """Azyah (32 GB GPUs): a cached VAE latent kept in CPU RAM. Only .mode() is kept (the latent's mean, the one value
+    the training loop reads) and it is moved to the GPU when a step reads it: the same numbers as keeping the
+    latent_dist on the GPU, a quarter of the memory, and none of it on the GPU."""
+
+    def __init__(self, dist, device):
+        self.value = dist.mode().detach().to("cpu").contiguous()
+        self.device = device
+
+    def mode(self):
+        return self.value.to(self.device, non_blocking=True)
+
+
+class _AzRowCache:
+    """Azyah (32 GB GPUs): per-step text embeddings kept in CPU RAM and moved to the GPU when a step reads them
+    (~8 MB per sample, ~27 GB for a 3,372-sample run, used to sit on the GPU while caching). Rows are kept once per
+    caption and shared only when bit-for-bit equal to a row already kept, so every step gets exactly the tensor it
+    had before."""
+
+    def __init__(self, device):
+        self.device = device
+        self.rows = {}
+        self.steps = []
+        self.nbytes = 0
+
+    def add(self, prompts, batch_tensor):
+        picked = []
+        for prompt, row in zip(prompts, batch_tensor.detach().to("cpu").unbind(0)):
+            kept = self.rows.setdefault(prompt, [])
+            same = next((r for r in kept if torch.equal(r, row)), None)
+            if same is None:
+                same = row.clone()
+                kept.append(same)
+                self.nbytes += same.numel() * same.element_size()
+            picked.append(same)
+        self.steps.append(picked)
+
+    def repeat(self, step):
+        self.steps.append(self.steps[step])
+
+    def __getitem__(self, step):
+        return torch.stack(self.steps[step]).to(self.device, non_blocking=True)
+
+    def __len__(self):
+        return len(self.steps)
+
+    def distinct(self):
+        return sum(len(v) for v in self.rows.values())
+
