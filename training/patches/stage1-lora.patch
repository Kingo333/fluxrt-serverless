 _SAVE_OPTIONS = StateDictOptions(full_state_dict=True, cpu_offload=True)
 _LOAD_OPTIONS = StateDictOptions(
     full_state_dict=True, broadcast_from_rank0=True)
+_LOAD_OPTIONS_PARTIAL = StateDictOptions(
+    full_state_dict=True, broadcast_from_rank0=True, strict=False)
+
+
+_WRAPPER_SEGMENTS = ("_checkpoint_wrapped_module.", "_fsdp_wrapped_module.", "_orig_mod.")
+
+
+def _fill_missing_optim_state(model, optim_state: dict) -> int:
+    """Azyah patch: AdamW only creates state for parameters that received a gradient.
+    Some LoRA adapters never do (e.g. the last double block's text branch: its output
+    is discarded after the block loop), so the saved optimizer state has no entry for
+    them and set_optimizer_state_dict raises KeyError on resume. Give them the empty
+    state AdamW would have (zero moments; their grads stay None, so steps skip them)."""
+    state = optim_state.get("state") or {}
+    if not state:
+        return 0
+    ref = next(iter(state.values()))
+    params = {}
+    for name, p in model.named_parameters():
+        for seg in _WRAPPER_SEGMENTS:
+            name = name.replace(seg, "")
+        params[name] = p
+    added = 0
+    for group in optim_state.get("param_groups", []):
+        for fqn in group.get("params", []):
+            if fqn in state or fqn not in params:
+                continue
+            shape = tuple(params[fqn].shape)
+            entry = {}
+            for k, v in ref.items():
+                if torch.is_tensor(v) and v.dim() == 0:
+                    entry[k] = v.clone()
+                elif torch.is_tensor(v):
+                    entry[k] = torch.zeros(shape, dtype=v.dtype)
+                else:
+                    entry[k] = v
+            state[fqn] = entry
+            added += 1
+    return added
+
+
+def _is_stage1_lora(model) -> bool:
+    return bool(getattr(model, "_azyah_stage1_lora", False))
 
 
