+def _add_stage1_lora(model: torch.nn.Module, cfg) -> None:
+    """Azyah patch: Stage 1 with LoRA adapters only (cfg.stage1_lora). Reuses the Stage 2
+    LoRA builder and the "generator" adapter name, so checkpoints use the same
+    generator_lora format that load_dit/_merge_generator_lora already read."""
+    from src.train_t2v_dmd import build_lora_config
+
+    logger = get_logger()
+    model.requires_grad_(False)
+    model.add_adapter(build_lora_config(cfg, model), adapter_name="generator")
+    model.set_adapter("generator")
+    dtype = PRECISION_TO_TYPE[cfg.dit_precision]
+    trainable = 0
+    for name, param in model.named_parameters():
+        if "lora_" in name:
+            if param.dtype != dtype:
+                param.data = param.data.to(dtype=dtype)
+            param.requires_grad_(True)
+            trainable += param.numel()
+    model._azyah_stage1_lora = True
+    logger.info(f"Stage 1 LoRA: {trainable / 1e6:.1f}M trainable adapter parameters; base frozen")
+
