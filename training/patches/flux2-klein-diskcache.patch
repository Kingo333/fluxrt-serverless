 class _AzCpuLatent:
     """Azyah (32 GB GPUs): a cached VAE latent kept in CPU RAM. Only .mode() is kept (the latent's mean, the one value
     the training loop reads) and it is moved to the GPU when a step reads it: the same numbers as keeping the
     latent_dist on the GPU, a quarter of the memory, and none of it on the GPU."""
 
     def __init__(self, dist, device):
         self.value = dist.mode().detach().to("cpu").contiguous()
         self.device = device
 
     def mode(self):
         return self.value.to(self.device, non_blocking=True)
 
 
+def _az_free_ram():
+    """CPU RAM really free for this process: the smaller of what the machine reports and what the container's
+    memory limit leaves (cgroup v2 or v1). psutil alone reports the whole host, so on a 94 GB Pod of a 282 GB
+    machine the fail-fast check below never fired (2026-11-16: the Pod was killed instead)."""
+    import psutil
+    free = psutil.virtual_memory().available
+    for limit_f, used_f, stat_f, key in (
+            ("/sys/fs/cgroup/memory.max", "/sys/fs/cgroup/memory.current", "/sys/fs/cgroup/memory.stat", "inactive_file"),
+            ("/sys/fs/cgroup/memory/memory.limit_in_bytes", "/sys/fs/cgroup/memory/memory.usage_in_bytes",
+             "/sys/fs/cgroup/memory/memory.stat", "total_inactive_file")):
+        try:
+            limit = open(limit_f).read().strip()
+            if limit == "max":
+                continue
+            limit, used = int(limit), int(open(used_f).read().strip())
+            # file pages the kernel can drop (the disk text cache, the dataset) are not "used": the working set
+            stat = dict(line.split() for line in open(stat_f) if len(line.split()) == 2)
+            used -= int(stat.get(key, 0))
+            if 0 < limit < (1 << 60):
+                free = min(free, max(0, limit - used))
+            break
+        except (OSError, ValueError):
+            continue
+    return free
