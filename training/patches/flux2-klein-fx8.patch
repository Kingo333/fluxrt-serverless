+# Azyah fxreal8: favourite #2 merged into the frozen weights with a small add-on trained on top, a steadiness term
+# between the two frames of a pair, a reference term to favourite #2's own prediction, and a safety check.
+_AZ_FX8 = {"seen": 0, "steady_on": 0, "data": 0.0, "steady": 0.0, "first_ref": None, "first_data": None,
+           "weight": 0.0, "done": False}
+
+
+def _azyah_lora_layers(state_dict):
+    """{module name: (lora_A, lora_B)} from a peft-style LoRA state dict (keys <module>.lora_A.weight)."""
+    out = {}
+    for k, a in state_dict.items():
+        if not k.endswith(".lora_A.weight"):
+            continue
+        name = k[: -len(".lora_A.weight")]
+        b = state_dict.get(name + ".lora_B.weight")
+        if b is None:
+            raise ValueError(f"the LoRA has no lora_B for {name}")
+        out[name] = (a, b)
+    return out
+
+
+def _azyah_lora_file_scale(path):
+    """alpha / rank from the file's settings record; 1.0 when there is none (our files store alpha = rank)."""
+    import glob
+
+    from safetensors import safe_open
+    files = [path] if os.path.isfile(path) else sorted(glob.glob(os.path.join(path, "*.safetensors")))
+    if not files:
+        return 1.0
+    try:
+        with safe_open(files[0], framework="pt") as f:
+            raw = (f.metadata() or {}).get("lora_adapter_metadata")
+        meta = json.loads(raw) if raw else {}
+    except Exception:  # noqa: BLE001 - a file without a readable record counts as alpha = rank
+        return 1.0
+    r = next((v for k, v in meta.items() if k.rsplit(".", 1)[-1] == "r" and isinstance(v, (int, float))), None)
+    al = next((v for k, v in meta.items() if k.rsplit(".", 1)[-1] == "lora_alpha" and isinstance(v, (int, float))), None)
+    return float(al) / float(r) if r and al else 1.0
+
+
+@torch.no_grad()
+def _azyah_merge_into(model, layers, scale=1.0):
+    """Adds scale * B @ A into each layer's weight (summed in float32, stored in the weight's own dtype).
+    Returns (layers merged, rounding error of the stored change relative to the change itself)."""
+    n, err2, ref2 = 0, 0.0, 0.0
+    for name, (a, b) in layers.items():
+        w = model.get_submodule(name).weight
+        delta = (b.to(w.device, torch.float32) @ a.to(w.device, torch.float32)) * scale
+        if tuple(delta.shape) != tuple(w.shape):
+            raise ValueError(f"{name}: the LoRA change {tuple(delta.shape)} does not fit the layer {tuple(w.shape)}")
+        old = w.detach().float().clone()
+        w.copy_((old + delta).to(w.dtype))
+        err2 += float(((w.float() - old) - delta).pow(2).sum())
+        ref2 += float(delta.pow(2).sum())
+        n += 1
+        del old, delta
+    return n, (err2 / ref2) ** 0.5 if ref2 > 0 else 0.0
+
+
+def _azyah_steady_term(x0_hat, x0, pairs):
+    """Per frame pair (two nearby frames of one clip, the same noise): the mean distance between the change from
+    one predicted picture to the other and the change from one real frame to the other, weighted towards the
+    places where the real frames barely change (exp(-|change| / its median)). Not turned down at high noise."""
+    terms = []
+    for i, j in pairs:
+        d_true = x0[i] - x0[j]
+        d_hat = x0_hat[i] - x0_hat[j]
+        mag = d_true.abs().mean(0, keepdim=True)
+        tau = mag.median().clamp(min=1e-4)
+        w = torch.exp(-mag / tau)
+        terms.append(((d_hat - d_true).abs().mean(0, keepdim=True) * w).sum() / w.sum().clamp(min=1e-6))
+    return torch.stack(terms).mean()
+
+
+def _azyah_ref_term(pred, ref_pred):
+    """Mean squared distance from the frozen model's own prediction. Uniform: the data term already counts the
+    garment and the face 3x (--mask_weight), so the add-on stays freest there and closest elsewhere."""
+    return ((pred.float() - ref_pred.float()) ** 2).mean()
+
+
+def _azyah_fx8_fail(reason):
+    print(f"FX8_SAFETY_FAILED: {reason}", flush=True)
+    raise SystemExit(3)
+
+
+def _azyah_fx8_check(args, logs, loss, fresh_start, weight_file):
+    """Called once per step while the first --safety_steps steps (or the steadiness calibration) last."""
+    st = _AZ_FX8
+    vals = {"loss": float(loss), **logs}
+    bad = [k for k, v in vals.items() if not math.isfinite(v)]
+    if bad:
+        _azyah_fx8_fail(f"not finite at step {st['seen']}: {', '.join(bad)}")
+    if st["seen"] < max(args.safety_steps, 1):
+        return
+    notes = []
+    if args.ref_weight > 0 and fresh_start:
+        r, d = st["first_ref"], st["first_data"]
+        if r is None or not r <= 1e-4 * max(d or 0.0, 1e-8):
+            _azyah_fx8_fail(f"the add-on does not start at the frozen model: reference term {r} at the first step "
+                            f"(data term {d})")
+        notes.append(f"start = the frozen model (reference term {r:.1e} at the first step)")
+    steady_on = args.steady_ratio > 0 or args.steady_weight > 0
+    if steady_on:
+        if st["steady_on"] == 0:
+            _azyah_fx8_fail(f"no frame pairs in the first {st['seen']} batches: the steadiness term never ran")
+        notes.append(f"steadiness term on in {st['steady_on']}/{st['seen']} batches")
+        if st["weight"] <= 0:
+            mean_s, mean_d = st["steady"] / st["steady_on"], st["data"] / st["steady_on"]
+            if not (mean_s > 0 and mean_d > 0):
+                _azyah_fx8_fail(f"the steadiness term ({mean_s}) or the data term ({mean_d}) is not positive at the start")
+            st["weight"] = args.steady_ratio * mean_d / mean_s
+            with open(weight_file, "w") as f:
+                json.dump({"steady_weight": st["weight"], "ratio": args.steady_ratio, "steady_at_start": mean_s,
+                           "data_at_start": mean_d, "batches": st["steady_on"]}, f)
+        notes.append(f"steadiness weight {st['weight']:.4g}")
+        print(f"STEADY_WEIGHT {st['weight']:.6g}", flush=True)
+    st["done"] = True
+    print(f"FX8_SAFETY_OK: {'; '.join(notes) or 'every term finite'}; every term finite over the first {st['seen']} steps",
+          flush=True)
+
