+def _azyah_pair_batches(indices, pair_ids, batch_size):
+    """Azyah fxreal3: batches in which both rows of each pair sit together: one pair + singles per batch
+    while pairs and singles last, then what remains. Rows whose pair id appears once count as singles."""
+    groups = {}
+    for idx in indices:
+        pid = pair_ids[idx % len(pair_ids)]
+        if pid:
+            groups.setdefault(pid, []).append(idx)
+    pairs = [g[:2] for g in groups.values() if len(g) >= 2]
+    in_pair = {i for g in pairs for i in g}
+    singles = [i for i in indices if i not in in_pair]
+    random.shuffle(pairs)
+    batches = []
+    while pairs or singles:
+        batch = []
+        if pairs:
+            batch += pairs.pop()
+        while len(batch) + 2 <= batch_size and pairs and not singles:
+            batch += pairs.pop()
+        while len(batch) < batch_size and singles:
+            batch.append(singles.pop())
+        batches.append(batch)
+    return batches
+
