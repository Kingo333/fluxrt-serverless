+def _azyah_pad_to(image, width, height):
+    """Fit inside width x height and pad with white (no stretch, no crop, no flip)."""
+    image = exif_transpose(image)
+    if image.mode != "RGB":
+        image = image.convert("RGB")
+    scale = min(width / image.width, height / image.height)
+    w, h = max(1, round(image.width * scale)), max(1, round(image.height * scale))
+    image = image.resize((w, h), Image.LANCZOS)
+    canvas = Image.new("RGB", (width, height), (255, 255, 255))
+    canvas.paste(image, ((width - w) // 2, (height - h) // 2))
+    return TF.normalize(TF.to_tensor(canvas), [0.5], [0.5])
+
