# Live Cam FluxRT-only image: the FluxRT engine of the dual image (Dockerfile.livecam) without JoyAI.
#
# Same base, system packages, FluxRT steps (pinned packages, patches, torchao, WebRTC) and app code as
# Dockerfile.livecam; only the JoyAI engine (its venv, SageAttention, CUTLASS/joyomni_ops, adapter) is left out.
# That makes the image about 4.5 GB smaller (about 10.8 GB instead of 15.3 GB compressed) and the build about
# a third as long. FluxRT runs exactly as in the dual image: JoyAI is never loaded when LIVECAM_ENGINE=fluxrt.
#
# JoyAI is still built from Dockerfile.livecam (tags livecam-dual-v1-*). On this image LIVECAM_ENGINE=joyai
# stops at start-up with "LIVECAM_ENGINE=joyai but /opt/joyai-venv/bin/python is missing (use the livecam-dual
# image)". tests/test_dockerfiles_fluxrt_only.py checks that the shared steps stay word for word identical.
#
# GPU (set on the RunPod endpoint): 32 GB PRO (RTX 5090) or 96 GB PRO (RTX PRO 6000); also older 48 GB cards.
# No model weights are baked in.
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

# Pinned: 2026-06-13 "flow upscaler and taef2". Bump on purpose, never track main.
ARG FLUXRT_REF=32206e8255b085b9075e05d389781bcbc728d513

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8765 \
    PORT_HEALTH=8765 \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    HF_HOME=/workspace/.cache/huggingface \
    FLUXRT_ROOT=/workspace/FluxRT \
    MODEL_ROOT=/workspace/FluxRT \
    CUDA_HOME=/usr/local/cuda

# ---------------------------------------------------------------------------
# System packages: FluxRT's list plus Python 3.10 headers/venv and a compiler
# (JoyAI's torch.compile / Triton kernels build at runtime).
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common ca-certificates curl gnupg \
        git git-lfs bash ffmpeg build-essential ninja-build \
        libgl1 libglib2.0-0 libgomp1 libsm6 libxext6 \
        python3.10 python3.10-dev python3.10-venv \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv \
    && rm -rf /var/lib/apt/lists/* \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 \
    && git lfs install \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3

# ---------------------------------------------------------------------------
# FluxRT engine (Dockerfile.fluxrt's steps, with every package version pinned)
# ---------------------------------------------------------------------------
WORKDIR /workspace
# Small Azyah patches to FluxRT (fluxrt/patches/*.patch: anchor reference + sampler mu override; LoRA fused
# before INT8, or the FP8 build), all inert unless the worker's config asks for them; git apply fails the build
# if upstream drifts.
COPY fluxrt/patches /tmp/fluxrt-patches
RUN git clone https://github.com/tensorforger/FluxRT.git /workspace/FluxRT \
    && cd /workspace/FluxRT && git checkout ${FLUXRT_REF} \
    && git -C /workspace/FluxRT apply /tmp/fluxrt-patches/*.patch
WORKDIR /workspace/FluxRT
# fluxrt/constraints.txt: the exact versions in today's Live Cam image (FluxRT's requirements.txt is unpinned),
# so a full rebuild installs the same diffusers/transformers/peft/quanto instead of whatever is newest that day.
COPY fluxrt/constraints.txt /tmp/fluxrt-constraints.txt
RUN /usr/bin/python3.12 -m pip install --upgrade pip==26.3 setuptools==84.2.1 wheel==0.48.0 \
    && /usr/bin/python3.12 -m pip install torch==2.9.1 torchvision==0.24.1 --index-url https://download.pytorch.org/whl/cu128 \
    && /usr/bin/python3.12 -m pip install -c /tmp/fluxrt-constraints.txt -r requirements.txt \
    && /usr/bin/python3.12 -m pip install -c /tmp/fluxrt-constraints.txt -e . \
    && /usr/bin/python3.12 -m pip install -c /tmp/fluxrt-constraints.txt fastapi "uvicorn[standard]" websockets pillow numpy "huggingface_hub[hf_transfer]"
# MediaPipe multiclass selfie segmenter (Apache-2.0) for the live-quality switches
# (FLUXRT_COMPOSITE / FLUXRT_REF_CLEAN / FLUXRT_CACHE_MASK=seg). --no-deps keeps its
# jax/jaxlib/opencv-contrib dependencies out (FluxRT's cv2 must stay); the listed extras are
# what the import needs (verified on Python 3.12 with numpy 2.x). The model is baked in so
# warm-up needs no network: version 1, checked by hash (the same file as ".../latest/", unchanged since 2023-04-26).
RUN /usr/bin/python3.12 -m pip install --no-deps mediapipe==0.10.21 \
    && /usr/bin/python3.12 -m pip install -c /tmp/fluxrt-constraints.txt absl-py attrs flatbuffers "protobuf>=4.25.3,<5" sounddevice matplotlib \
    && mkdir -p /opt/models \
    && curl -fsSL -o /opt/models/selfie_multiclass_256x256.tflite \
        https://storage.googleapis.com/mediapipe-models/image_segmenter/selfie_multiclass_256x256/float32/1/selfie_multiclass_256x256.tflite \
    && echo "c6748b1253a99067ef71f7e26ca71096cd449baefa8f101900ea23016507e0e0  /opt/models/selfie_multiclass_256x256.tflite" | sha256sum -c -
# FP8 (FLUXRT_PRECISION=fp8, off by default; fluxrt/azyah_fuse_lora.py): torchao 0.14.1, the release made for
# torch 2.9 (no dependencies of its own), in its OWN folder, outside the normal package path: PEFT 0.21 (which
# loads the LoRA) refuses to run at all once it can see a torchao older than 0.16, so only the FP8 step adds the
# folder, after the LoRA is fused, and the INT8 path runs exactly as before. WebRTC media path (LIVECAM_WEBRTC):
# aiortc and its packages at the versions of the thin WebRTC test image (until now only the thin image had them).
COPY livecam/requirements-webrtc.txt /tmp/livecam-webrtc-requirements.txt
RUN /usr/bin/python3.12 -m pip install --no-deps --target /opt/azyah-torchao torchao==0.14.1 \
    && /usr/bin/python3.12 -m pip install -c /tmp/fluxrt-constraints.txt -r /tmp/livecam-webrtc-requirements.txt
RUN /usr/bin/python3.12 -c "import fastapi, uvicorn, numpy, PIL, cv2, torch, fluxrt, transformers, diffusers, peft, mediapipe, aiortc, av; from mediapipe.tasks.python import vision; from fluxrt.stream_processor.azyah_fuse_lora import build_fp8_transformer, fuse_lora_into_int8; print('fluxrt env ok', torch.__version__, torch.version.cuda, 'diffusers', diffusers.__version__, 'transformers', transformers.__version__, 'peft', peft.__version__, 'mediapipe', mediapipe.__version__, 'aiortc', aiortc.__version__)" \
    && /usr/bin/python3.12 -c "from peft.import_utils import is_torchao_available; assert not is_torchao_available(), 'PEFT must not see torchao'; print('PEFT does not see torchao: ok')" \
    && /usr/bin/python3.12 -c "from fluxrt.stream_processor.azyah_fuse_lora import import_torchao; import_torchao(); import torchao; assert torchao.__version__ == '0.14.1', torchao.__version__; print('torchao', torchao.__version__, 'from', torchao.__file__)"

# ---------------------------------------------------------------------------
# App code (FluxRT entry points; no JoyAI adapter)
# ---------------------------------------------------------------------------
COPY server.py bootstrap.py session_token.py /app/
COPY livecam /app/livecam
RUN /usr/bin/python3.12 -m py_compile /app/server.py /app/bootstrap.py /app/session_token.py /app/livecam/*.py \
    && cd /app && SESSION_SIGNING_SECRET=build-check /usr/bin/python3.12 -c "import server; print('fluxrt server import ok')" \
    && cd /app && /usr/bin/python3.12 -c "from livecam import webrtc; assert webrtc.available(), webrtc.unavailable_reason(); print('webrtc ok')"

ENV LIVECAM_ENGINE=fluxrt

EXPOSE 8765
WORKDIR /workspace/FluxRT
# bootstrap.py reads LIVECAM_ENGINE: fluxrt runs here (joyai needs the dual image).
CMD ["/usr/bin/python3.12", "-u", "/app/bootstrap.py"]
