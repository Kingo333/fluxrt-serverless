+def _azyah_spread(x, m):
+    """Per picture and channel: the spread (standard deviation) of x inside the weight map m (B, 1, H, W)."""
+    n = m.sum((-2, -1)).clamp(min=1e-6)
+    mean = (x * m).sum((-2, -1)) / n
+    return (((x - mean[..., None, None]) ** 2 * m).sum((-2, -1)) / n).clamp(min=1e-8).sqrt()
+
+
+def _azyah_keep_spread_term(x0_hat, x0_ref, m):
+    """Azyah fxreal9, one-sided: how far the spread of the predicted picture inside m falls below the frozen
+    model's own (favourite #2's) for the same input. Zero where the add-on is as contrasty as favourite #2 or
+    more: it stops the fabric going flat without pulling it anywhere else."""
+    return torch.relu(_azyah_spread(x0_ref.float(), m) - _azyah_spread(x0_hat.float(), m)).mean()
+
