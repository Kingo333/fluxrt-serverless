+# Azyah fxreal5: garment-photo sizes for --cond_2_sizes, as [(width, height, weight)]; None = one size.
+_AZ_REF_SIZES = None
+_AZ_REF_RNG = random.Random(0)
+
+
+def _azyah_parse_ref_sizes(spec):
+    sizes = []
+    for part in str(spec).split(","):
+        part = part.strip()
+        if not part:
+            continue
+        size, _, weight = part.partition(":")
+        w, h = (int(v) for v in size.lower().split("x"))
+        if w % 16 or h % 16:  # the FluxRT worker rounds FLUXRT_REF_WIDTH/HEIGHT to multiples of 16
+            raise ValueError(f"--cond_2_sizes: {size} is not a multiple of 16")
+        if float(weight or 1) <= 0:
+            raise ValueError(f"--cond_2_sizes: weight of {size} must be positive")
+        sizes.append((w, h, float(weight or 1)))
+    if not sizes:
+        raise ValueError("--cond_2_sizes is empty")
+    return sizes
+
+
+def _azyah_pick_ref_size():
+    total = sum(wt for _, _, wt in _AZ_REF_SIZES)
+    r = _AZ_REF_RNG.uniform(0, total)
+    for w, h, wt in _AZ_REF_SIZES:
+        r -= wt
+        if r <= 0:
+            return w, h
+    return _AZ_REF_SIZES[-1][0], _AZ_REF_SIZES[-1][1]
+
+
