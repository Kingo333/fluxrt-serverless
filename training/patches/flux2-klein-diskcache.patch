 _AZ_COND3_RNG = random.Random(6)
 _AZ_COND3_COUNTS = {"with": 0, "without": 0}
 
 
 def _azyah_anchor_tensor(image, width, height):
     """The anchor picture as the trainer's tensors: RGB, resized to the answer's size (it was stored at that size)."""
     image = exif_transpose(image)
     if image.mode != "RGB":
         image = image.convert("RGB")
     if image.size != (width, height):
         image = image.resize((width, height), Image.BILINEAR)
     return TF.normalize(TF.to_tensor(image), [0.5], [0.5])
 
 
 def _azyah_use_anchor(examples):
     """A batch uses its anchors only when every row has one (the tokens are concatenated per batch), and then with
     probability --cond_3_prob."""
     if not examples or not all("cond_images_3" in e for e in examples):
         return False
     return _AZ_COND3_RNG.random() < _AZ_COND3_PROB
 
 
