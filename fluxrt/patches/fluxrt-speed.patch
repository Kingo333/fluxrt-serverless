+# Azyah patch (the worker's FLUXRT_FAST_MASK, default on): within one transformer call every layer gets the same
+# mask (preprocess_mask runs once at the top of forward), so the active-token index is worked out once per mask
+# instead of in every layer. FluxRT's `if mask.any(): mask.nonzero()` makes the CPU wait for the GPU twice per
+# layer, about 440 times per generated frame; with this on it is once per mask per call. Results are identical.
+AZYAH_FAST_MASK = False
+_AZYAH_ACTIVE = {}
+
+
+@torch.compiler.disable
+def _azyah_reset_active_index():
+    _AZYAH_ACTIVE.clear()
+
+
+@torch.compiler.disable
+def _azyah_active_index(seq_mask: torch.Tensor):
+    """Indices of the active tokens of a 1-D mask (worked out once per transformer call), or None if none."""
+    key = (seq_mask.data_ptr(), seq_mask.shape[0], seq_mask.stride(0), seq_mask._version)
+    active_idx = _AZYAH_ACTIVE.get(key)
+    if active_idx is None:
+        active_idx = seq_mask.nonzero(as_tuple=False).squeeze(-1)  # one wait; its size is then known
+        _AZYAH_ACTIVE[key] = active_idx
+    return active_idx if active_idx.numel() > 0 else None
+
+
